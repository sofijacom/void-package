# Template file for 'iruka-xbps'
pkgname=iruka-xbps
version=0.1.0
revision=1
build_style=meson
build_helper=qemu
configure_args="-Dcpp_std=c++17 -Dwarning_level=2"
hostmakedepends="gettext pkg-config"
makedepends="gtk+3-devel libglib-devel"
depends="gtk+3"
short_desc="GTK+3 frontend for the XBPS package manager"
maintainer="Sofiya <sofija.p2018@gmail.com>"
license="WTFPL AND BSD-3-Clause"
homepage="https://github.com/javiercplus/iruka-xbps"
distfiles="https://github.com/javiercplus/iruka-xbps/archive/refs/tags/${version}.tar.gz"
checksum="44c1d70be02cf2fbca9adf7106042fe3163adaa93b86d42cb2792c7e861343d4"

subpackages="iruka-xbps-i18n"

do_configure() {
	meson setup build --prefix=/usr ${configure_args}
}

do_build() {
	meson compile -C build
}

do_install() {
	DESTDIR="${DESTDIR}" meson install -C build --no-rebuild
}

do_check() {
	meson test -C build
}

iruka-xbps-i18n_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - localization files"
	pkg_install() {
		vmove "usr/share/locale"
	}
}
