# Template file for 'Rox-Filer2-QT'
pkgname=Rox-Filer2-QT
version=1.0.7
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -G Ninja"
build_wrksrc="qt"
hostmakedepends="cmake ninja pkg-config qt6-tools"
makedepends="
 qt6-base-devel
 qt6-svg-devel
 qt6-tools-devel
 libX11-devel
 libXft-devel
 libXext-devel
 expat-devel
 dbus-devel
 polkit-devel
 fuse-devel"

depends="libXext libmagic shared-mime-info polkit cifs-utils fuse3"

short_desc="ROX-Filer port to Qt6"
maintainer="Sofiya <sofija.p2018@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/josejp2424/Rox-Filer2-QT"
distfiles="https://github.com/josejp2424/Rox-Filer2-QT/archive/refs/tags/v${version}-QT.tar.gz"
checksum="53937525dc086a33a8b1c98eaed69f411eb4645fe463374d26ef37f550eb53e3"

do_install() {
    # CMake will automatically install everything specified in install()
    cmake --build "${wrksrc}/qt/build" --target install -- DESTDIR="${DESTDIR}"

    # In mime.cpp the path /usr/share/mime/packages/rox-filer2-qt.xml is hardcoded.
    # CMakeLists.txt does NOT install it. We'll create a stub to prevent fopen errors.
    vmkdir usr/share/mime/packages
    touch "${DESTDIR}/usr/share/mime/packages/rox-filer2-qt.xml"

    # Documentation
    if [ -d "${DESTDIR}/usr/share/rox-filer2-qt/help" ]; then
        vdoc "${DESTDIR}/usr/share/rox-filer2-qt/help"
    fi
}
