# Template file for 'nixie-clock'

pkgname=nixie-clock
version=1.1.0
revision=1
build_style=cmake
configure_args="--prefix=/usr"
hostmakedepends="pkg-config vala meson ninja"
makedepends="gtk+3-devel cairo-devel"
depends="gtk+3 cairo"
short_desc="Nixie Clock Desktop Gadget"
maintainer="Sofiya <sofiya@v.com>"
license="MIT"
homepage="https://github.com/sofijacom/nixie-clock"
distfiles="https://github.com/sofijacom/nixie-clock/archive/refs/tags/v${version}.tar.gz"
checksum=3ef259f6fca0b2ce1275a1187bb6b483e53e39582596ba67262266548a62259b


do_install() {
	vbin nixie-clock

	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/nixie-clock.desktop <<EOF
[Desktop Entry]
Name=Nixie Clock
Comment=Sleek Desktop Nixie Tube Clock Widget
Exec=nixie-clock
Icon=preferences-system-time
Terminal=false
Type=Application
Categories=Utility;Clock;GTK;
EOF
}

post_install() {
	vlicense LICENSE
}
