# Template file for 'rox-filer2'
pkgname=rox-filer2
version=2.13.0.8
revision=3
_tarver="${version%.*}-${version##*.}"
wrksrc="ROX-Filer2-${_tarver}"
hostmakedepends="pkg-config python3 gettext meson ninja bash gzip"
makedepends="
	gtk+3-devel
	glib-devel
	libxml2-devel
	libSM-devel
	libICE-devel
	libX11-devel
	shared-mime-info
	samba-devel
	pango-devel
	gtk-layer-shell-devel
	udisks2-devel
"
depends="
	gtk+3
	glib
	libxml2
	libSM
	libICE
	libX11
	polkit
	shared-mime-info
	smbclient
	hicolor-icon-theme
	desktop-file-utils
	util-linux
	file
	gtk-layer-shell
	udisks2
	cifs-utils
"
short_desc="Rox-Filer2 lightweight GTK3 file manager and desktop"
maintainer="Sofiya <sofija.p2018@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/josejp2424/ROX-Filer2"
distfiles="https://github.com/josejp2424/ROX-Filer2/archive/refs/tags/v${_tarver}.tar.gz"
checksum=ae6345189be16bd634c7dbac5cc47e41b7385dd657c8877faf15a7a4f836231b
provides="rox-filer-${version}_${revision}"
replaces="rox-filer>=0"

LANGS="ar ca de es fr hu it ja pt ru zh"

do_prepare() {
	msg_normal "Validating and building translations\n"
	for lang in ${LANGS}; do
		if [ -f "${wrksrc}/ROX-Filer/src/po/${lang}.po" ]; then
			msgfmt -c "${wrksrc}/ROX-Filer/src/po/${lang}.po" -o /dev/null
		fi
	done
	rm -rf "${wrksrc}/ROX-Filer/Messages"
	mkdir -p "${wrksrc}/ROX-Filer/Messages"
	for lang in ${LANGS}; do
		if [ -f "${wrksrc}/ROX-Filer/src/po/${lang}.po" ]; then
			(cd "${wrksrc}/ROX-Filer/src/po" && ./make-mo "$lang")
		fi
	done
}

do_build() {
	msg_normal "Building Rox-Filer2 $version for Void Linux\n"
	rm -rf "${wrksrc}/build-void"
	mkdir -p "${wrksrc}/build-void"

	cd "${wrksrc}/build-void"
	meson setup --buildtype=release -Dsmb=enabled -Dportable_devices=auto "${wrksrc}"
	meson compile -C "${wrksrc}/build-void"

	[[ -x "${wrksrc}/build-void/ROX-Filer" ]] || { echo "ERROR: ROX-Filer binary was not produced." >&2; exit 1; }
	[[ -x "${wrksrc}/build-void/rox-find" ]] || { echo "ERROR: rox-find binary was not produced." >&2; exit 1; }
	[[ -x "${wrksrc}/build-void/rox-mount-helper" ]] || { echo "ERROR: rox-mount-helper binary was not produced." >&2; exit 1; }
}

do_install() {
	msg_normal "Installing Rox-Filer2 $version\n"
	vmkdir usr/lib/rox-filer2
	vmkdir usr/bin
	vmkdir usr/share/applications
	vmkdir usr/share/pixmaps
	vmkdir usr/share/icons/hicolor/scalable/apps
	vmkdir usr/share/icons/hicolor/scalable/mimetypes
	vmkdir usr/share/mime/packages
	vmkdir usr/share/licenses/${pkgname}
	vmkdir usr/share/doc/${pkgname}
	vmkdir usr/share/man/man1

	local appdir="${PKGDESTDIR}/usr/lib/rox-filer2"
	local bdir="${wrksrc}/build-void"

	# Копируем само приложение
	cp -a "${wrksrc}/ROX-Filer/." "${appdir}/"
	install -Dm0755 "${bdir}/ROX-Filer" "${appdir}/ROX-Filer"
	install -Dm0755 "${bdir}/rox-mount-helper" "${appdir}/rox-mount-helper"
	rm -rf "${appdir}/build" "${appdir}/src" "${appdir}/ROX-Filer.dbg" "${appdir}/ROX"

	if [ -d "${wrksrc}/package-assets/ROX" ]; then
		cp -a "${wrksrc}/package-assets/ROX" "${appdir}/ROX"
	fi
	install -Dm0644 "${wrksrc}/data/icons/hicolor/256x256/apps/rox-filer2.png" "${appdir}/ROX-Filer.png"
	ln -sfn ROX-Filer.png "${appdir}/.DirIcon"

	# Иконки и MIME
	local size
	for size in 16 22 24 32 48 64 96 128 192 256; do
		install -Dm0644 "${wrksrc}/data/icons/hicolor/${size}x${size}/apps/rox-filer2.png" \
			"${PKGDESTDIR}/usr/share/icons/hicolor/${size}x${size}/apps/rox-filer2.png"
	done
	install -Dm0644 "${wrksrc}/data/icons/hicolor/scalable/apps/rox-filer2.svg" \
		"${PKGDESTDIR}/usr/share/icons/hicolor/scalable/apps/rox-filer2.svg"
	for icon in rox-filer2.svg ROX-Filer.svg Rox-Filer2.svg; do
		ln -sf rox-filer2.svg "${PKGDESTDIR}/usr/share/pixmaps/${icon}"
	done
	for icon in application-pet.svg application-x-sfs.svg application-x-squashfs-image.svg; do
		install -Dm0644 "${wrksrc}/package-assets/ROX/MIME/${icon}" \
			"${PKGDESTDIR}/usr/share/icons/hicolor/scalable/mimetypes/${icon}"
	done
	if [ -f "${wrksrc}/data/mime/rox-filer2-image-mounter.xml" ]; then
		install -Dm0644 "${wrksrc}/data/mime/rox-filer2-image-mounter.xml" \
			"${PKGDESTDIR}/usr/share/mime/packages/rox-filer2-image-mounter.xml"
	fi

	# rox-find
	install -Dm0755 "${bdir}/rox-find" "${PKGDESTDIR}/usr/bin/rox-find"
	if [ -f "${wrksrc}/rox-find/data/rox-find.desktop" ]; then
		install -Dm0644 "${wrksrc}/rox-find/data/rox-find.desktop" \
			"${PKGDESTDIR}/usr/share/applications/rox-find.desktop"
	fi
	if [ -f "${wrksrc}/rox-find/data/rox-find.svg" ]; then
		install -Dm0644 "${wrksrc}/rox-find/data/rox-find.svg" \
			"${PKGDESTDIR}/usr/share/pixmaps/rox-find.svg"
	fi
	for size in 48 64 128 256; do
		install -Dm0644 "${wrksrc}/rox-find/data/icons/${size}x${size}/apps/rox-find.png" \
			"${PKGDESTDIR}/usr/share/icons/hicolor/${size}x${size}/apps/rox-find.png"
	done
	if [ -d "${wrksrc}/rox-find/locale" ]; then
		cp -a "${wrksrc}/rox-find/locale/." "${PKGDESTDIR}/usr/share/locale/"
	fi

	# Документация
	install -Dm0644 "${wrksrc}/LICENSE" "${PKGDESTDIR}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm0644 "${wrksrc}/CHANGELOG" "${PKGDESTDIR}/usr/share/doc/${pkgname}/CHANGELOG"
	install -Dm0644 "${wrksrc}/README.md" "${PKGDESTDIR}/usr/share/doc/${pkgname}/README.md"

	# Man-страницы
	if [ -f "${wrksrc}/data/man/rox-find.1" ]; then
		install -Dm0644 "${wrksrc}/data/man/rox-find.1" "${PKGDESTDIR}/usr/share/man/man1/rox-find.1"
		gzip -n -9 "${PKGDESTDIR}/usr/share/man/man1/rox-find.1"
	fi
	if [ -f "${wrksrc}/data/man/rox.1" ]; then
		install -Dm0644 "${wrksrc}/data/man/rox.1" "${PKGDESTDIR}/usr/share/man/man1/rox.1"
		gzip -n -9 "${PKGDESTDIR}/usr/share/man/man1/rox.1"
	fi

	local target="rox.1.gz"
	if [ ! -f "${PKGDESTDIR}/usr/share/man/man1/rox.1.gz" ]; then
		target="rox-find.1.gz"
	fi
	for alias in roxfiler Rox-Filer2 ROX-Filer rox-wayland rox-x11; do
		ln -sf "/usr/share/man/man1/${target}" "${PKGDESTDIR}/usr/share/man/man1/${alias}.1.gz"
	done

	# Создаем wrapper для запуска (вместо vbin)
	vmkdir usr/bin
	cat > "${PKGDESTDIR}/usr/bin/rox-filer2" << EOF
#!/bin/sh
exec /usr/lib/rox-filer2/ROX-Filer "\$@"
EOF
	chmod 0755 "${PKGDESTDIR}/usr/bin/rox-filer2"

	# Очистка прав
	find "${PKGDESTDIR}/usr/share/applications" -type f -name '*.desktop' -exec chmod 0644 {} + 2>/dev/null || true
	find "${PKGDESTDIR}/usr/share/pixmaps" -type f -exec chmod 0644 {} + 2>/dev/null || true
}

do_strip() {
	v_strip "${wrksrc}/build-void/ROX-Filer"
	v_strip "${wrksrc}/build-void/rox-mount-helper"
	v_strip "${wrksrc}/build-void/rox-find"
}

do_clean() {
	rm -rf "${wrksrc}/build-void"
}
