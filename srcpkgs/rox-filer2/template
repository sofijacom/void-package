# Функция подготовки: валидация .po файлов и компиляция .mo.
# Полностью повторяет вашу функцию prepare_messages().
do_prepare() {
	vmsg "Validating and building translations"
	for lang in ar ca de es fr hu it ja pt ru zh; do
		if [ -f "$FILESDIR/../ROX-Filer/src/po/$lang.po" ]; then
			msgfmt -c "$FILESDIR/../ROX-Filer/src/po/$lang.po" -o /dev/null
		fi
	done
	# Если у вас есть скрипт check-po-formats.py, его вызов можно оставить здесь.
	rm -rf "$wrksrc/ROX-Filer/Messages"
	mkdir -p "$wrksrc/ROX-Filer/Messages"
	for lang in ar ca de es fr hu it ja pt ru zh; do
		if [ -f "$FILESDIR/../ROX-Filer/src/po/$lang.po" ]; then
			(cd "$FILESDIR/../ROX-Filer/src/po" && ./make-mo "$lang")
		fi
	done
}

# Основная функция сборки.
# Вызывает ваш скрипт, который сделает всю работу в изолированной папке $wrksrc.
do_build() {
	# Скрипт ожидает, что он лежит в корне исходников.
	# $FILESDIR указывает на srcpkgs/rox-filer2/files/ внутри репозитория xbps-src.
	# Копируем его в рабочую директорию, чтобы пути внутри скрипта не сломались.
	cp "$FILESDIR/build_void.sh" "$wrksrc/"
	chmod +x "$wrksrc/build_void.sh"

	# Запускаем сборку. --fakeroot нужен для корректной работы xbps-create внутри xbps-src.
	chroot "$XBPS_MASTERDIR" \
		su - root -c "cd /builddir/$pkgname-$version && ./build_void.sh"
}

# Функция установки.
# Для build_style=meta она должна быть пустой, так как пакет уже создан
# и проиндексирован вашим скриптом в папке $outputdir.
do_install() {
	:
}

# Функция очистки. Вызывается при 'xbps-src clean'.
# Повторяет логику аргумента --clean вашего скрипта.
do_clean() {
	vmsg "Cleaning Rox-Filer2 build directories"
	rm -rf "$wrksrc/build-void" "$wrksrc/output"
}
